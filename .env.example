# Core
DATABASE_URL=sqlite:///data/finsent.db
NEWS_SOURCE_BASE_URL=https://finance.yahoo.com
DEFAULT_TICKER=AAPL
DEFAULT_NEWS_LIMIT=20
DEFAULT_RETURN_WINDOW_MINUTES=60
DEFAULT_PRICE_INTERVAL=15m
SIGNAL_LOOKBACK_BARS=16
FINSENT_LOG_LEVEL=INFO

# Runtime refresh and cache windows
LIVE_REFRESH_INTERVAL_MS=15000
LIVE_REFRESH_MAX_AGE_MINUTES=2
LIVE_PRICE_MAX_AGE_MINUTES=1440
LIVE_NEWS_MAX_AGE_MINUTES=1440
QUOTE_CACHE_TTL_SECONDS=10
PRICE_HISTORY_CACHE_TTL_SECONDS=60
NEWS_CACHE_TTL_SECONDS=60
ANALYSIS_CACHE_TTL_SECONDS=86400

# Provider selection
SENTIMENT_PROVIDER=finbert
NEWS_DISCOVERY_PROVIDER=gemini
LIVE_DATA_PROVIDER=auto

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_USE_SEARCH_GROUNDING=true
LLM_ANALYSIS_LIMIT=5

# Polygon
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io

# Kite
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_BASE_URL=https://api.kite.trade

# Marketaux
MARKETAUX_API_TOKEN=
MARKETAUX_BASE_URL=https://api.marketaux.com/v1

# Optional / legacy providers
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_FEED=iex

# Optional / research
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
MODEL_NAME=ProsusAI/finbert
